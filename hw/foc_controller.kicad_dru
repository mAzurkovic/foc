(version 1)
# Custom DRC rules for a 4-layer motor controller, JLCPCB, 2 oz outer / 1 oz inner copper.
# FOC controller (hw/foc_controller.kicad_pcb). Netclasses are assigned in hw/foc_controller.kicad_pro
# (net_settings.netclass_patterns). HC = high current, low voltage (shunt top).
# tools/render fails if this file does not load: KiCad silently ignores the whole file when any rule is invalid.

# ---- Voltage clearance (IPC-2221B Table 6-1, 51 to 100 V; bus max 54 V) ------------
# B2 external uncoated: 0.6 mm, applied wherever exposed copper (a pad) is involved.
# B4 external with permanent polymer coating: 0.13 mm. Tracks, zones and tented vias sit under
# solder mask, so between them the netclass clearance (>= 0.15 mm) applies.
# B1 internal: 0.1 mm, held at 0.2 mm for fab margin.
# A package's own pins are exempt: the part maker sets their pitch.
# ---- Widths --------------------------------------------------------------------
# Policy: smallest width the fab and the current allow. Netclass widths in .kicad_pro are the
# routing widths; these rules are the floors. Fine-pitch pins neck down inside IC courtyards.
# High-current paths are zones. HV/HC tracks are the SHx gate returns (paired with the 0.3 mm
# gate tracks), Kelvin links and via links: 0.4 mm floor, not 1.0 mm, so SHx can pair with GHx.
# JLC 4-layer: 2 oz outer 0.15 / 0.15 mm; inner 1 oz 0.09 / 0.09 mm, held at 0.1.
# ---- Vias ----------------------------------------------------------------------
# Signal vias 0.2 / 0.45 mm: the smallest JLCPCB 4-layer via with no extra charge
# (a 0.2 mm hole costs more only below a 0.45 mm via). 0.2 mm drill counts as 0.5 A.
# Vias carrying power-stage or gate current stay 0.3 / 0.6 mm (1 A each). GND vias may be
# either: use 0.3 / 0.6 mm where they carry power-stage return current.
# JLCPCB: pad hole-to-hole 0.45 mm, via hole-to-hole 0.2 mm (held at 0.25).
(rule "hole to hole"
  (constraint hole_to_hole (min 0.45mm)))

(rule "via hole to hole"
  (condition "A.Type == 'Via' && B.Type == 'Via'")
  (constraint hole_to_hole (min 0.25mm)))

(rule "via hole to track"
  (constraint hole_clearance (min 0.2mm)))

# ---- High-current pads connect solid to zones -----------------------------------
(rule "solid zone connection on power"
  (condition "A.hasNetclass('HV') || A.hasNetclass('HC')")
  (constraint zone_connection solid))

# Power-stage return path (shunt GND ends, bus caps, sense net ties, MOSFETs): solid, the motor current flows here.
(rule "solid GND on power-stage parts"
  (condition "A.Type == 'Pad' && A.NetName == 'GND' && (A.memberOfFootprint('R8') || A.memberOfFootprint('R9') || A.memberOfFootprint('R10') || A.memberOfFootprint('C1') || A.memberOfFootprint('C2') || A.memberOfFootprint('C3') || A.memberOfFootprint('C4') || A.memberOfFootprint('C5') || A.memberOfFootprint('C6') || A.memberOfFootprint('C7') || A.memberOfFootprint('C8') || A.memberOfFootprint('C9') || A.memberOfFootprint('C10') || A.memberOfFootprint('C44') || A.memberOfFootprint('C45') || A.memberOfFootprint('C46') || A.memberOfFootprint('C49') || A.memberOfFootprint('C50') || A.memberOfFootprint('C51') || A.memberOfFootprint('C52') || A.memberOfFootprint('NT*') || A.memberOfFootprint('Q*'))")
  (constraint zone_connection solid))

# Small signal parts: one spoke is enough where routing leaves no room for two (thermal relief still helps soldering).
(rule "one spoke for small GND pads"
  (condition "A.Type == 'Pad' && A.NetName == 'GND'")
  (constraint min_resolved_spokes 1))

(rule "thermal spokes elsewhere"
  (constraint thermal_spoke_width (min 0.3mm)))

# ---- Diff pairs ----------------------------------------------------------------
# USB 2.0 full speed (12 Mbit/s, ~83 ns per bit): skew in the tens of ps is irrelevant; 0.5 mm is a high-speed rule.
(rule "USB pair"
  (condition "A.hasNetclass('USB')")
  (constraint diff_pair_uncoupled (max 3mm))
  (constraint skew (max 10mm)))

(rule "CAN pair"
  (condition "A.hasNetclass('CAN')")
  (constraint diff_pair_uncoupled (max 5mm)))

# ---- Shunt Kelvin sense: keep away from switching nodes -------------------------
# sense_escape: rule areas = U* / R* courtyards + router.sense_exempt_band; sense pins sit 0.5 mm from phase pins on the chip itself
(rule "sense away from phase"
  (condition "A.hasNetclass('SENSE') && (B.hasNetclass('HV') || B.hasNetclass('HV_SIG')) && !A.intersectsCourtyard('U*') && !A.intersectsCourtyard('R*') && !A.intersectsArea('sense_escape')")
  (constraint clearance (min 1.0mm)))

# ---- Manufacturing and assembly -------------------------------------------------
(rule "copper to edge"
  (constraint edge_clearance (min 0.5mm)))

(rule "courtyards"
  (constraint courtyard_clearance (min 0.2mm)))

(rule "silk off pads"
  (layer "F.SilkS")
  (constraint silk_clearance (min 0.15mm)))

(rule "solid zone connection on power connector pins"
  (condition "A.Type == 'Pad' && (A.memberOfFootprint('J1') || A.memberOfFootprint('J2'))")
  (constraint zone_connection solid))

# ---- sizing.py: generated, do not edit by hand (re-run sizing.py --write)
(rule "sizing: fab floor, outer"
  (layer outer)
  (condition "A.Type == 'Track'")
  (constraint track_width (min 0.15mm)))
(rule "sizing: fab floor, inner"
  (layer inner)
  (condition "A.Type == 'Track'")
  (constraint track_width (min 0.1mm)))
(rule "sizing: PWR width, inner"
  (layer inner)
  (condition "A.Type == 'Track' && A.hasNetclass('PWR') && !A.intersectsCourtyard('U*')")
  (constraint track_width (min 0.17mm)))
(rule "sizing: inner clearance"
  (layer inner)
  (condition "A.Type == 'Track' || A.Type == 'Via' || A.Type == 'Zone'")
  (constraint clearance (min 0.1mm)))
(rule "sizing: GATE_HS exposed pads, outer"
  (layer outer)
  (condition "(A.Type == 'Pad' || B.Type == 'Pad') && A.hasNetclass('GATE_HS') && !B.hasNetclass('GATE_HS') && !A.intersectsCourtyard('Q*') && !A.intersectsCourtyard('U*') && !B.intersectsCourtyard('Q*') && !B.intersectsCourtyard('U*')")
  (constraint clearance (min 0.6mm)))
(rule "sizing: HV exposed pads, outer"
  (layer outer)
  (condition "(A.Type == 'Pad' || B.Type == 'Pad') && A.hasNetclass('HV') && !B.hasNetclass('HV') && !A.intersectsCourtyard('Q*') && !A.intersectsCourtyard('U*') && !B.intersectsCourtyard('Q*') && !B.intersectsCourtyard('U*')")
  (constraint clearance (min 0.6mm)))
(rule "sizing: HV_SIG exposed pads, outer"
  (layer outer)
  (condition "(A.Type == 'Pad' || B.Type == 'Pad') && A.hasNetclass('HV_SIG') && !B.hasNetclass('HV_SIG') && !A.intersectsCourtyard('Q*') && !A.intersectsCourtyard('U*') && !B.intersectsCourtyard('Q*') && !B.intersectsCourtyard('U*')")
  (constraint clearance (min 0.6mm)))
(rule "sizing: via size"
  (condition "A.Type == 'Via'")
  (constraint hole_size (min 0.2mm))
  (constraint via_diameter (min 0.45mm))
  (constraint annular_width (min 0.124mm)))
# ---- end sizing.py
